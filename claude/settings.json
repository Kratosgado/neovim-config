{
  "env": {
    "CCGUI_CLI_LOGIN_AUTHORIZED": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(mvn clean compile:*)",
      "Bash(dart run *)",
      "Bash(flutter analyze *)",
      "Bash(grep -v \"^$\")",
      "Bash(python3 -c ' *)",
      "mcp__claude_ai_Atlassian__searchJiraIssuesUsingJql",
      "mcp__claude_ai_Atlassian__getJiraIssue",
      "Bash(grep -E \"\\\\.java$\")",
      "Bash(python3)",
      "Bash(grep -iE \"\\\\.\\(java|graphql|yml|yaml\\)$\")",
      "Bash(git-town diff-parent *)",
      "Bash(git remote *)",
      "Bash(gh api *)",
      "Bash(gh secret *)",
      "Bash(git-town status *)",
      "Bash(git push *)",
      "Bash(gh pr create --base develop --title 'feat\\(bonus\\): replace BonusScore with PiEarnedBonus/MonthlyEarnedBonus models' --body ' *)"
    ],
    "defaultMode": "default"
  },
  "statusLine": {
    "type": "command",
    "command": "bash /home/esslifie/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "jdtls-lsp@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "atlassian@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "kotlin-lsp@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "theme": "auto",
  "skipAutoPermissionPrompt": true,
  "model": "opus[1m]"
}
