{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "tornikegomareli.spaces",
          "showApps": "all",
          "iconStyle": "color",
          "iconSize": 16,
          "groupApps": true,
          "dimUnfocused": true,
          "focusedTitle": false,
          "titleLength": 32,
          "tooltips": true,
          "activeStyle": "accent",
          "labelStyle": "number",
          "pillBackground": false,
          "density": "normal",
          "settingsButton": "never",
          "hideEmpty": true,
          "holdSuperNumbers": true
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarcraft.productivity"
        },
        {
          "id": "devgtv.docker"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power",
          "showPercentage": true
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "io.github.mtolhuys.fathom"
    },
    {
      "id": "b.peek"
    }
  ],
  "version": 1
}
